# Copy to .env on the server:  cp .env.example .env   then edit the values.

# Your web address (DuckDNS name). For a first test without a domain use:  DOMAIN=:80
DOMAIN=hyperplane-yourname.duckdns.org

# Database password — any long random text (used only inside Docker)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional: keep the DuckDNS name updated (start with: docker compose --profile duckdns up -d)
DUCKDNS_SUBDOMAIN=hyperplane-yourname
DUCKDNS_TOKEN=

# Nightly database backups kept for this many days
BACKUP_KEEP_DAYS=14
